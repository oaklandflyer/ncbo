{
  "name": "ncbo-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:content": "tsx scripts/check-content.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "fetch:enrollment": "tsx ../scripts/fetch-enrollment.ts",
    "verify": "npm run check && npm run test && npm run check:content && npm run check:contrast",
    "build:templates": "tsx scripts/build-templates.ts",
    "prebuild": "tsx scripts/build-templates.ts"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.2.0",
    "@types/pdfkit": "^0.17.6",
    "@types/topojson-client": "^3.1.5",
    "astro": "^7.2.2",
    "d3-geo": "^3.1.1",
    "pdfkit": "^0.19.1",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "us-atlas": "^3.0.1",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0"
  }
}
