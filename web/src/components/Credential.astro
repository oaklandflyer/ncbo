---
/**
 * Shows a specific, named credential — RD, CSCS, MD — and nothing else.
 *
 * There is no generic "verified expert" variant and there must not be one. A
 * competition credential (an IFBB pro card, a national qualification) is evidence
 * about competing, not about nutrition or medicine, and a badge that flattens the
 * difference invites a student to take dietary advice on the strength of someone's
 * stage placing.
 *
 * NCBO holds no credential records for anyone today, so nothing renders this yet.
 */
interface Props {
  /** e.g. "RD", "CSCS", "MD". Free text is allowed but must be the credential itself. */
  credential: string;
  /** Awarding body, if known. */
  issuer?: string;
}
const { credential, issuer } = Astro.props;
---

<span class="cred">
  <abbr class="cred__abbr" title={issuer ? `${credential} — ${issuer}` : credential}>{credential}</abbr>
</span>

<style>
  .cred {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-sm);
    color: var(--text-soft);
  }
  .cred__abbr {
    text-decoration: none;
  }
</style>
