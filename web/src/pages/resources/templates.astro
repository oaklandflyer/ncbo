---
import BaseLayout from '../../layouts/BaseLayout.astro';

/**
 * Files here are generated by scripts/build-templates.ts into public/templates/
 * before every build (npm prebuild), from the Markdown originals in
 * data/templates/. Editing the Markdown is what changes the PDF.
 */
const templates = [
  {
    slug: 'officer-transition-checklist',
    title: 'Officer transition checklist',
    blurb:
      'What the outgoing board hands over and by when — accounts, documents, compliance dates, relationships, and the honest account of what failed this year.',
  },
  {
    slug: 'event-risk-assessment',
    title: 'Event risk assessment',
    blurb:
      'Emergency action plan, first aid provision, waivers, a hazard table with controls and owners, weather policy and sign-off. Complete it before the event.',
  },
  {
    slug: 'recruiting-table-kit',
    title: 'Recruiting table kit',
    blurb:
      'What to bring, what to say, what never to say at a table, and the follow-up step that actually converts interest into members.',
  },
  {
    slug: 'meeting-agenda',
    title: 'Meeting agenda',
    blurb:
      'A standing agenda that keeps a club meeting inside its hour, with risk and safety as a fixed item every time.',
  },
];
---

<BaseLayout
  title="Club Templates"
  description="Downloadable NCBO club templates: officer transition checklist, event risk assessment, recruiting table kit and meeting agenda, as Markdown and PDF."
>
  <div class="wrap page">
    <p class="back"><a href="/resources">← All resources</a></p>
    <h1>Club templates</h1>
    <p class="lead">
      Four documents a club actually needs, in Markdown so you can edit them and PDF so you can
      print them. Generated locally at build time — no third-party document service is involved,
      and downloading one tells nobody anything.
    </p>
    <p class="note">
      These are starting points modelled on common university sport club requirements. Your
      school's own policy governs your club. See
      <a href="/resources/club-operations">club operations</a> for the detail.
    </p>

    <ul class="list">
      {
        templates.map((template) => (
          <li>
            <h2>{template.title}</h2>
            <p>{template.blurb}</p>
            <p class="dl">
              <a href={`/templates/${template.slug}.pdf`} download>
                PDF
              </a>
              <a href={`/templates/${template.slug}.md`} download>
                Markdown
              </a>
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: 2rem 3rem;
  }
  .back {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1.25rem;
  }
  .lead {
    font-size: 1.1rem;
    color: var(--text-soft);
    margin-top: 0.75rem;
  }
  .note {
    margin-top: 0.75rem;
    color: var(--text-soft);
    font-size: 0.95rem;
  }
  .list {
    list-style: none;
    margin-top: 2rem;
    display: grid;
    gap: 1rem;
  }
  .list li {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 1.25rem;
  }
  .list h2 {
    font-size: 1.2rem;
  }
  .list p {
    margin-top: 0.5rem;
    color: var(--text-soft);
  }
  .dl {
    display: flex;
    gap: 1rem;
    margin-top: 0.85rem;
  }
  .dl a {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border: 1px solid var(--steel);
    color: var(--steel-deep);
    padding: 0.3rem 0.9rem;
    border-radius: var(--r-sm);
    text-decoration: none;
  }
  .dl a:hover {
    background: var(--steel-wash);
  }
</style>
