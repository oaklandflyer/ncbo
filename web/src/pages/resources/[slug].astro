---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MedicalDisclaimer from '../../components/MedicalDisclaimer.astro';
import SourceList from '../../components/SourceList.astro';

export const getStaticPaths = (async () => {
  const resources = await getCollection('resources');
  return resources.map((resource) => ({ params: { slug: resource.id }, props: { resource } }));
}) satisfies GetStaticPaths;

interface Props {
  resource: CollectionEntry<'resources'>;
}
const { resource } = Astro.props;
const { Content } = await render(resource);
---

<BaseLayout title={resource.data.title} description={resource.data.description} ogType="article">
  <div class="wrap page">
    <p class="back"><a href="/resources">← All resources</a></p>
    <h1>{resource.data.title}</h1>
    <p class="lead">{resource.data.description}</p>
    <p class="updated">Last updated {resource.data.updated}</p>

    {resource.data.medicalDisclaimer && <MedicalDisclaimer />}

    <article class="prose">
      <Content />
    </article>

    <SourceList sources={resource.data.sources} />
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: 2rem 3rem;
  }
  .back {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1.25rem;
  }
  .lead {
    font-size: 1.12rem;
    color: var(--text-soft);
    margin-top: 0.75rem;
  }
  .updated {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-top: 0.5rem;
  }
  .prose :global(h2) {
    margin-top: 2.25rem;
  }
  .prose :global(h3) {
    margin-top: 1.75rem;
    font-size: 1.1rem;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-top: 0.85rem;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
  }
  .prose :global(li) {
    margin-bottom: 0.4rem;
    max-width: 70ch;
  }
  .prose :global(blockquote) {
    border-left: 4px solid var(--steel);
    background: var(--surface);
    padding: 1rem 1.25rem;
    margin-top: 1.25rem;
    border-radius: 0 var(--r) var(--r) 0;
  }
  .prose :global(blockquote p) {
    margin-top: 0.5rem;
  }
  .prose :global(blockquote p:first-child) {
    margin-top: 0;
  }
  .prose :global(strong) {
    color: var(--text);
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--surface-raised);
    padding: 0.1rem 0.3rem;
    border-radius: var(--r-sm);
  }
</style>
