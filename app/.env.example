# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role. Bypasses row-level security entirely, so it is the one key in
# this project that can read and write every row. Two features need it:
# permanent account deletion, and sending push (a lead notifying an applicant
# cannot read that person's subscriptions under RLS, by design).
#
# Never prefix this with NEXT_PUBLIC_. The prefix alone would inline it into
# the client bundle and hand every visitor the database. Server-side only, and
# `src/lib/supabase/admin.js` is the only module that reads it.
SUPABASE_SERVICE_ROLE_KEY=

# Where magic-link emails send people back to.
# Local: http://localhost:3000 — Production: https://app.thencbo.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web push (VAPID). Generate a pair with `npm run push:keys` and paste them
# here and into Vercel. The public key is inlined into the client bundle by
# design — the browser needs it to subscribe. The private key signs each send
# and must never carry the NEXT_PUBLIC_ prefix.
#
# Regenerating the pair invalidates every saved subscription: each device has
# to be toggled back on. Generate once.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact the push services can reach about this application. Optional.
VAPID_SUBJECT=mailto:info@thencbo.org
